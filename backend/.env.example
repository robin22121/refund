# mock | hyphen
COLLECTOR=mock
HYPHEN_USER_ID=
HYPHEN_HKEY=
HYPHEN_EKEY=
HYPHEN_BASE_URL=https://api.hyphen.im

# AI 전략 초안: claude | mock. 비워 두면 ANTHROPIC_API_KEY가 있을 때 claude
ANALYST=
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5

# 운영이면 production. 이때 기본 접근 키와 임시 암호화 키를 쓰면 서버가 뜨지 않는다
APP_ENV=dev

# 세무사 검토실 접근 키 (체험판 기본값 demo-advisor, 운영은 32자 이상)
ADVISOR_KEY=demo-advisor

# 접수 건 저장 암호화 키 (AES-256-GCM, Base64 32바이트). 만들기: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 비워 두면 개발 환경에서만 실행할 때마다 임시 키를 만든다
DATA_ENCRYPTION_KEY=

# 성공보수 요율(부가세 별도)과 세무사가 플랫폼에 내는 경정청구 1건당 이용료(원)
SUCCESS_FEE_RATE=0.15
PLATFORM_FEE_PER_CASE=50000
